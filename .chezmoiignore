# File này là template, và match theo TARGET path (đường dẫn trong $HOME), không phải source path.

# Các file chỉ thuộc repo, KHÔNG apply vào $HOME
README.md
install.sh
KEYBINDINGS.md
SYSTEM-SETUP.md
system-apps.sh
GUIDE.md
CLAUDE.md

# Neo bằng "/" để chỉ khớp ~/.gitignore ở gốc. Không neo thì pattern khớp mọi cấp,
# nuốt luôn ~/.config/nvim/.gitignore (đến từ dot_config/nvim/dot_gitignore).
/.gitignore

# Sổ tay + hook riêng tư: chỉ có ở nhánh chezmoi, không apply vào $HOME.
# (Nhánh public-release không có thư mục này; dòng ignore thừa ra thì vô hại.)
.personal/**

# ---------------------------------------------------------------------------
# Khác biệt theo OS. Nguyên tắc: mặc định là dùng chung, chỉ loại trừ khi tool
# không tồn tại trên OS đó. Dùng `ne windows` (không phải `eq linux`) cho các
# tool Linux+macOS, để máy macOS sau này tự động nhận mà không phải sửa lại.
# ---------------------------------------------------------------------------

{{ if ne .chezmoi.os "windows" }}
# nushell chỉ chạy trên máy Windows
AppData/**
{{ end }}

{{ if eq .chezmoi.os "windows" }}
# zsh: Windows dùng nushell thay thế
.zshrc
.local/share/zsh/**
# tmux và ghostty: chưa có bản Windows (ghostty mới chỉ Linux/macOS)
.tmux.conf
.config/tmux/**
.config/ghostty/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# systemd user environment + fcitx5: chỉ có trên Linux
.config/environment.d/**
{{ end }}

{{ if not (and .signingkey (stat (joinPath .chezmoi.homeDir .signingkey))) }}
# Không ký commit thì không cần danh sách signer.
# Phải kiểm CẢ sự tồn tại của file key, không chỉ .signingkey: allowed_signers.tmpl
# `include` file đó, thiếu file là chết TOÀN BỘ `chezmoi apply` chứ không riêng file này.
# (Điều kiện lặp ở dot_gitconfig.tmpl — sửa thì sửa cả hai.)
.config/git/allowed_signers
{{ end }}
