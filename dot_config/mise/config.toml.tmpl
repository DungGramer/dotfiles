{{- /* Mac Intel (darwin/amd64): một số tool KHÔNG có bản build cho kiến trúc này.
       Thượng nguồn chỉ còn phát hành darwin/arm64 (Apple Silicon) — aqua báo thẳng
       "unsupported env: darwin/amd64". Để ngoài guard thì `mise install` FAIL TOÀN BỘ
       trên máy Intel, kéo theo cả `chezmoi apply` báo lỗi.
       Trên máy đó cài bằng Homebrew (có bottle x86_64), zsh/git tự tìm thấy trên PATH:
           brew install git-delta fd eza atuin btop
       Máy Apple Silicon và Linux không đụng gì tới nhánh này. */ -}}
{{- $macIntel := and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "amd64") -}}
{{- /* Hai tool dưới đây không có bản macOS NÀO, kể cả Apple Silicon:
         eza  -> GitHub release chỉ phát hành asset linux + windows
         btop -> aqua báo `unsupported env: darwin/arm64 (supported: ["linux"])`
       Guard bằng $macIntel là chưa đủ: máy Apple Silicon vẫn cố cài rồi
       `mise install` fail, kéo `chezmoi apply` fail theo. Trên mac cài bằng
       Homebrew (cả hai đều có bottle arm64 + x86_64):
           brew install eza btop */ -}}
{{- $mac := eq .chezmoi.os "darwin" -}}
# Version pin cứng, KHÔNG dùng "latest".
#
# Lý do: mục tiêu của repo này là máy mới ra giống hệt máy cũ, và người khác clone về
# ra đúng thứ mình đang chạy. "latest" phá cả hai — mỗi lần cài là một version khác,
# tuỳ thời điểm. Bug "máy tôi chạy được" bắt đầu từ đây.
#
# Nâng version:  mise outdated          # xem cái nào có bản mới
#                mise upgrade --bump    # bump số trong chính file này
# rồi commit lại — để việc đổi version là một thay đổi có chủ đích, thấy được trong git log.

[tools]
chezmoi = "2.71.0"
node = "24.18.0"
python = "3.12.13"
neovim = "0.12.4"
tree-sitter = "0.26.11"

# Git
lazygit = "0.63.0"
gh = "2.96.0"
{{- if not $macIntel }}
delta = "0.19.2"
{{- end }}
# Quét secret cho hook .githooks/pre-commit
gitleaks = "8.30.1"

# Shell / CLI
{{- if not $macIntel }}
atuin = "18.17.0"
{{- end }}
direnv = "2.37.1"
jq = "1.8.2"
yq = "4.53.3"
yazi = "26.5.6"
tlrc = "1.13.1"
dust = "1.2.4"
duf = "0.9.1"

# Kubernetes / Docker
k9s = "0.51.0"
kubectx = "0.11.0"
kubens = "0.11.0"
stern = "1.34.0"
lazydocker = "0.25.2"

# CLI nền — .zshrc và config nushell gọi THẲNG mấy tool này lúc khởi động shell.
# Không chỗ nào khác cài chúng: system-apps.sh chỉ lo driver + app GUI, install.sh chỉ
# apt zsh/git/curl/wget/unzip. Thiếu là zsh báo lỗi mỗi lần mở và mất prompt; nushell
# thì vỡ hẳn config vì `source` là parse-time.
bat = "0.26.1"
ripgrep = "15.1.0"
{{- if not $macIntel }}
fd = "10.4.2"
{{- end }}
zoxide = "0.10.0"
starship = "1.26.0"
fzf = "0.74.0"
# eza phải chỉ đích danh backend ubi: registry của mise chỉ map eza -> cargo:eza,
# mà build bằng cargo thì cần sẵn Rust toolchain. ubi lấy thẳng binary từ GitHub release.
{{- if not $mac }}
"ubi:eza-community/eza" = "0.23.5"
{{- end }}
{{- if eq .chezmoi.os "windows" }}
# Chỉ Windows: carapace là completion cho nushell; bên zsh dùng fzf-tab nên không cần.
carapace = "1.7.3"
{{- end }}
{{- if ne .chezmoi.os "windows" }}

# Thượng nguồn không phát hành bản Windows (mise báo "unsupported env: windows/amd64").
# Để ngoài guard thì `mise install` fail trên MỌI máy Windows, không riêng máy nào.
{{- if not $mac }}
btop = "1.4.7"
{{- end }}
jless = "0.9.0"
{{- end }}

[settings]
lockfile = true
idiomatic_version_file_enable_tools = []
